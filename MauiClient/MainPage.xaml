<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiClient.MainPage">

    <Grid ColumnDefinitions="*,2*,*">

        <VerticalStackLayout Grid.Column="1">
        
            <Label FontSize="Medium" HorizontalOptions="Center" Grid.Column="1" Grid.Row="0">Add</Label>

            <Entry x:Name="Model" Placeholder="Type car model" Grid.Column="1" Grid.Row="1"></Entry>

            <Entry x:Name="txtBrand" Placeholder="Type car brand" Grid.Column="1" Grid.Row="2"></Entry>

            <Entry x:Name="txtPrice" Placeholder="Type car price" Grid.Column="1" Grid.Row="3"></Entry>

            <DatePicker x:Name="txtRelease" HorizontalOptions="Center" Grid.Column="1" Grid.Row="4"></DatePicker>

            <Button x:Name="btnSave" Text="Save" Clicked="btnSave_Clicked" Grid.Column="1" Grid.Row="5"></Button>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
