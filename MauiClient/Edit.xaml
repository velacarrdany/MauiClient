<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiClient.Edit"
             Title="Edit">
    <Grid ColumnDefinitions="*,2*,*">

        <VerticalStackLayout Grid.Column="1" Spacing="10">

            <Label FontSize="Medium" HorizontalOptions="Center" Grid.Column="1" Grid.Row="0">Add</Label>

            <Entry x:Name="txtModelo" Placeholder="Type car Modelo" Grid.Column="1" Grid.Row="1"></Entry>

            <Entry x:Name="txtMarca" Placeholder="Type car Marca" Grid.Column="1" Grid.Row="2"></Entry>

            <Entry x:Name="txtPrecio" Placeholder="Type car Precio" Grid.Column="1" Grid.Row="3"></Entry>

            <DatePicker x:Name="txtLanzamiento" HorizontalOptions="Center" Grid.Column="1" Grid.Row="4"></DatePicker>

            <Button x:Name="btnSave" Text="Save" Clicked="btnSave_Clicked" Grid.Column="1" Grid.Row="5"></Button>

        </VerticalStackLayout>

    </Grid>
</ContentPage>