<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiClient.Index"
             Title="Index">

    <VerticalStackLayout>
        <Button x:Name="btnAdd"
                Text="Add"
                Clicked="btnAdd_Clicked"
                WidthRequest="100"
                HeightRequest="40"
                HorizontalOptions="Center"
                VerticalOptions="Start"></Button>

        <CollectionView x:Name="collection">
            <CollectionView.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,*,*,*,*,*">
                        <Label Grid.Column="0"
                               Grid.Row="0"
                               HorizontalOptions="Center">Id</Label>
                        <Label Grid.Column="1"
                               Grid.Row="0"
                               HorizontalOptions="Center">Brand</Label>
                        <Label Grid.Column="2"
                               Grid.Row="0"
                               HorizontalOptions="Center">Model</Label>
                        <Label Grid.Column="3"
                               Grid.Row="0"
                               HorizontalOptions="Center">Price</Label>
                        <Label Grid.Column="4"
                               Grid.Row="0"
                               HorizontalOptions="Center">Release</Label>
                        <Label Grid.Column="5"
                               Grid.Row="0"
                               HorizontalOptions="Center">Actions</Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.HeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout>
                        <Label Text="{Binding Id}"></Label>
                        <Label Text="{Binding Brand}"></Label>
                        <Label Text="{Binding Model}"></Label>
                        <Label Text="{Binding Price}"></Label>
                        <Label Text="{Binding Release}"></Label>
                        <Button x:Name="btnDelete"
                                    Text="Delete"></Button>
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    
</ContentPage>